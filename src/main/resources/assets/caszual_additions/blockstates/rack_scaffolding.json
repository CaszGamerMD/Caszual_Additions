{
  "multipart": [
    {
      "when": {
        "folded": "false",
        "ladder_hatch": "false"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_deck"
      }
    },
    {
      "when": {
        "folded": "false",
        "ladder_hatch": "true"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_hatch"
      }
    },
    {
      "when": {
        "folded": "false",
        "rail_north": "true"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_rail_north"
      }
    },
    {
      "when": {
        "folded": "false",
        "rail_south": "true"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_rail_south"
      }
    },
    {
      "when": {
        "folded": "false",
        "rail_east": "true"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_rail_east"
      }
    },
    {
      "when": {
        "folded": "false",
        "rail_west": "true"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_rail_west"
      }
    },
    {
      "when": {
        "folded": "true",
        "facing": "north"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_folded",
        "y": 0
      }
    },
    {
      "when": {
        "folded": "true",
        "facing": "east"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_folded",
        "y": 90
      }
    },
    {
      "when": {
        "folded": "true",
        "facing": "south"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_folded",
        "y": 180
      }
    },
    {
      "when": {
        "folded": "true",
        "facing": "west"
      },
      "apply": {
        "model": "caszual_additions:block/rack_scaffolding_folded",
        "y": 270
      }
    }
  ]
}
